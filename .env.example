# Spotly Web3 Platform Environment Configuration

# Botchain Testnet Details
NEXT_PUBLIC_CHAIN_ID=968
NEXT_PUBLIC_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_EXPLORER_URL=https://scan.bohr.life

# Deployed Spotly Contract Address
# Fill this in after deploying with `npm run deploy:botchain`
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Deployer Private Key (Required only for contract deployment via Hardhat)
PRIVATE_KEY=your_private_key_here

